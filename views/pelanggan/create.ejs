
<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/pelanggan.css">
</head>

<body class="pelanggan-page">

  <%- include('../partials/navbar') %>

  <main class="pelanggan-main">

    <div class="pelanggan-card pelanggan-form">

      <h1 class="pelanggan-judul">Tambah Pelanggan</h1>

      <p class="pelanggan-deskripsi">
        Silakan isi data pelanggan baru.
      </p>

      <% if (error) { %>
        <div class="pelanggan-alert pelanggan-alert-error">
          <%= error %>
        </div>
      <% } %>

      <form action="/pelanggan/tambah" method="POST">

        <div class="form-group">
          <label for="nama">Nama Pelanggan</label>

          <input
            type="text"
            id="nama"
            name="nama"
            placeholder="Masukkan nama pelanggan"
            maxlength="100"
            required
          >
        </div>

        <div class="form-group">
          <label for="no_hp">Nomor HP</label>

          <input
            type="tel"
            id="no_hp"
            name="no_hp"
            placeholder="081234567890"
            pattern="08[0-9]{8,13}"
            maxlength="15"
            required
          >
        </div>

        <div class="form-actions">

          <button
            type="submit"
            class="pelanggan-btn pelanggan-btn-primary">
            Simpan Pelanggan
          </button>

          <a
            href="/pelanggan"
            class="pelanggan-btn pelanggan-btn-secondary">
            Kembali
          </a>

        </div>

      </form>

    </div>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>
