
<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { title: 'Tambah Meja - Sunday Cafe' }) %>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/meja.css">
</head>
<body class="management-page meja-screen">

  <%- include('../partials/navbar') %>

  <main class="meja-page">
    <div class="meja-container">

      <div class="meja-header">
        <div>
          <span class="meja-eyebrow">SUNDAY CAFE MANAGEMENT</span>
          <h1>Tambah Meja</h1>
          <p>Tambahkan meja baru ke sistem cafe.</p>
        </div>
        <a href="/meja" class="meja-btn meja-btn-back">
          Kembali
        </a>
      </div>

      <% if (pesan) { %>
        <div class="meja-alert" role="alert">
          <%= pesan %>
        </div>
      <% } %>

      <section class="meja-form-card">
        <h2>Form Tambah Meja</h2>

        <form action="/meja/tambah" method="POST">

          <div class="meja-form-group">
            <label for="nomor_meja">Nomor Meja</label>
            <input type="text"
                   id="nomor_meja"
                   name="nomor_meja"
                   placeholder="Contoh: M04"
                   maxlength="20"
                   required>
          </div>

          <div class="meja-form-group">
            <label for="kapasitas">Kapasitas Meja</label>
            <input type="number"
                   id="kapasitas"
                   name="kapasitas"
                   min="1"
                   placeholder="Contoh: 4"
                   required>
          </div>

          <div class="meja-form-group">
            <label for="status">Status Meja</label>
            <select name="status" id="status" required>
                <option value="tersedia">Tersedia</option>
                <option value="terisi">Terisi</option>
                <option value="reservasi">Reservasi</option>
            </select>
          </div>

          <div class="meja-form-actions">
            <button type="submit" class="meja-btn meja-btn-primary">
              Simpan Meja
            </button>
            <a href="/meja" class="meja-btn meja-btn-back">
              Batal
            </a>
          </div>
        </form>
      </section>

    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
