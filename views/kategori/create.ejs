
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../partials/head', { title: title }) %>
</head>

<body class="management-page">

    <%- include('../partials/navbar') %>

    <main class="container management-main">

        <div class="category-form-layout">

            <div class="category-form-header">
                <span class="category-eyebrow">
                    SUNDAY CAFE MANAGEMENT
                </span>

                <h1>Tambah Kategori</h1>

                <p>
                    Buat kategori baru untuk mengelompokkan
                    menu favorit di Sunday Cafe.
                </p>
            </div>

            <div class="form-card category-form-card">

                <div class="category-form-title">
                    <span class="category-form-icon">☕</span>

                    <div>
                        <h2>Informasi Kategori</h2>
                        <p>Lengkapi informasi berikut.</p>
                    </div>
                </div>

                <% if (errorMessage) { %>
                    <div class="form-alert" role="alert">
                        <%= errorMessage %>
                    </div>
                <% } %>

                <form action="/kategori/tambah"
                      method="POST"
                      class="category-form">

                    <div class="form-group">
                        <label for="nama">
                            Nama Kategori
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="nama"
                            name="nama"
                            placeholder="Contoh: Makanan Ringan"
                            maxlength="100"
                            required
                        >

                        <small>
                            Gunakan nama kategori yang jelas
                            dan mudah dikenali.
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="deskripsi">
                            Deskripsi
                        </label>

                        <textarea
                            id="deskripsi"
                            name="deskripsi"
                            rows="4"
                            maxlength="500"
                            placeholder="Tuliskan deskripsi kategori..."
                        ></textarea>

                        <small>
                            Opsional, maksimal 500 karakter.
                        </small>
                    </div>

                    <div class="category-form-actions">

                        <a href="/kategori"
                           class="btn-cancel">
                            Batal
                        </a>

                        <button type="submit"
                                class="btn-save">
                            + Simpan Kategori
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>
