
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Menu | Sunday Cafe</title>

  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/head', { title: 'Daftar Menu' }) %>
  <link rel="stylesheet" href="/css/menu.css">
</head>

<body>
  <%- include('../partials/navbar') %>

  <main class="container menu-page">

    <!-- HEADER -->
    <div class="menu-header">
      <div>
        <span class="menu-eyebrow">SUNDAY CAFE MANAGEMENT</span>
        <h1>Daftar Menu</h1>
        <p>Kelola makanan, minuman, dan dessert cafe dengan mudah.</p>
      </div>

      <a href="/menu/tambah" class="menu-btn-primary">
        + Tambah Menu
      </a>
    </div>

    <!-- PESAN -->
    <% if (pesan) { %>
      <div class="menu-notice" role="status">
        <%= pesan %>
      </div>
    <% } %>

    <!-- INFORMASI TOTAL MENU -->
    <div class="menu-summary">
      <div>
        <span class="menu-summary-label">Total Menu</span>
        <strong><%= menus.length %> Menu</strong>
      </div>
      <span class="menu-summary-note">
        Daftar makanan & minuman
      </span>
    </div>

    <!-- DAFTAR MENU -->
    <% if (menus.length === 0) { %>

      <div class="menu-empty">
        <h2>Belum Ada Menu</h2>
        <p>Tambahkan menu pertama untuk cafe kamu.</p>
        <a href="/menu/tambah" class="menu-btn-primary">
          + Tambah Menu
        </a>
      </div>

    <% } else { %>

      <div class="menu-table-container">

        <table class="menu-table">
          <thead>
            <tr>
              <th>No</th>
              <th>Foto</th>
              <th>Nama Menu</th>
              <th>Kategori</th>
              <th>Harga</th>
              <th>Stok</th>
              <th>Aksi</th>
            </tr>
          </thead>

          <tbody>
            <% menus.forEach((menu, index) => { %>

              <tr>
                <td data-label="No">
                  <%= index + 1 %>
                </td>

                <!-- GAMBAR -->
                <td data-label="Foto">
                  <div class="menu-image-box">
                    <% if (menu.gambar) { %>
                      <img
                        src="<%= menu.gambar %>"
                        alt="<%= menu.nama %>"
                        loading="lazy"
                        onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
                      >
                      <span class="menu-no-image" hidden>☕</span>
                    <% } else { %>
                      <span class="menu-no-image">☕</span>
                    <% } %>
                  </div>
                </td>

                <!-- NAMA MENU -->
                <td data-label="Nama Menu">
                  <span class="menu-name">
                    <%= menu.nama %>
                  </span>
                </td>

                <!-- KATEGORI -->
                <td data-label="Kategori">
                  <span class="menu-category">
                    <%= menu.nama_kategori || 'Tanpa Kategori' %>
                  </span>
                </td>

                <!-- HARGA -->
                <td data-label="Harga">
                  <span class="menu-price">
                    Rp <%= Number(menu.harga).toLocaleString('id-ID') %>
                  </span>
                </td>

                <!-- STOK -->
                <td data-label="Stok">
                  <span class="menu-stock">
                    <%= menu.stok %>
                  </span>
                </td>

                <!-- TOMBOL AKSI -->
                <td data-label="Aksi">
                  <div class="menu-actions">

                    <a
                      href="/menu/edit/<%= menu.id %>"
                      class="menu-btn-edit">
                      Edit
                    </a>

                    <form
                      action="/menu/hapus/<%= menu.id %>"
                      method="POST"
                      onsubmit="return confirm('Yakin ingin menghapus menu ini?')">

                      <button
                        type="submit"
                        class="menu-btn-delete">
                        Hapus
                      </button>

                    </form>

                  </div>
                </td>
              </tr>

            <% }) %>
          </tbody>
        </table>

      </div>

    <% } %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
