<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <%- include('../partials/head', { title: 'Edit Menu' }) %>
  <link rel="stylesheet" href="/css/menu.css">
</head>

<body class="management-page">
  <%- include('../partials/navbar') %>

  <main class="container menu-page">

    <!-- HEADER -->
    <div class="menu-header">
      <div>
        <span class="menu-eyebrow">SUNDAY CAFE MANAGEMENT</span>
        <h1>Edit Menu</h1>
        <p>Perbarui informasi makanan atau minuman cafe.</p>
      </div>

      <a href="/menu" class="menu-btn-back">
        ← Kembali
      </a>
    </div>

    <!-- PESAN ERROR -->
    <% if (pesan) { %>
      <div class="menu-alert" role="alert">
        <%= pesan %>
      </div>
    <% } %>

    <!-- FORM EDIT -->
    <section class="menu-form-panel">

      <div class="menu-panel-heading">
        <h2>Perbarui Informasi Menu</h2>
        <p>Ubah data yang diperlukan, lalu simpan perubahan.</p>
      </div>

      <form
        action="/menu/edit/<%= menu.id %>"
        method="POST"
        class="menu-form">

        <!-- NAMA MENU -->
        <div class="menu-field">
          <label for="nama">Nama Menu</label>

          <input
            type="text"
            id="nama"
            name="nama"
            value="<%= menu.nama %>"
            maxlength="100"
            required
          >
        </div>

        <!-- KATEGORI -->
        <div class="menu-field">
          <label for="kategori_id">Kategori Menu</label>

          <select
            id="kategori_id"
            name="kategori_id"
            required>

            <% kategori.forEach(item => { %>
              <option
                value="<%= item.id %>"
                <%= Number(menu.kategori_id) === Number(item.id)
                    ? 'selected' : '' %>>
                <%= item.nama %>
              </option>
            <% }) %>

          </select>
        </div>

        <!-- HARGA DAN STOK -->
        <div class="menu-form-row">

          <div class="menu-field">
            <label for="harga">Harga (Rp)</label>

            <input
              type="number"
              id="harga"
              name="harga"
              value="<%= menu.harga %>"
              min="0"
              max="99999999.99"
              step="0.01"
              required
            >
          </div>

          <div class="menu-field">
            <label for="stok">Stok Tersedia</label>

            <input
              type="number"
              id="stok"
              name="stok"
              value="<%= menu.stok %>"
              min="0"
              step="1"
              required
            >
          </div>

        </div>

        <!-- GAMBAR -->
        <div class="menu-field">
          <label for="gambar">Alamat Gambar</label>

          <input
            type="text"
            id="gambar"
            name="gambar"
            value="<%= menu.gambar || '' %>"
            placeholder="/images/nama-menu.jpg"
          >

          <small class="menu-help">
            Opsional. Simpan gambar di folder
            public/images, lalu masukkan alamatnya.
            Contoh: /images/matcha-latte.jpg
          </small>
        </div>

        <!-- PREVIEW GAMBAR -->
        <% if (menu.gambar) { %>
          <div class="menu-edit-preview">
            <p>Foto Menu Saat Ini</p>

            <img
              src="<%= menu.gambar %>"
              alt="<%= menu.nama %>"
              onerror="this.hidden=true;"
            >
          </div>
        <% } %>

        <!-- TOMBOL SIMPAN DAN BATAL -->
        <div class="menu-form-actions">

          <button
            type="submit"
            class="menu-btn-primary">
            Simpan Perubahan
          </button>

          <a href="/menu" class="menu-btn-cancel">
            Batal
          </a>

        </div>

      </form>

    </section>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
