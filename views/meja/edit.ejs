
<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { title: 'Edit Meja - Sunday Cafe' }) %>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/meja.css">
</head>
<body class="management-page meja-screen">

  <%- include('../partials/navbar') %>

  <main class="meja-page">
    <div class="meja-container">

      <div class="meja-header">
        <div>
          <span class="meja-eyebrow">SUNDAY CAFE MANAGEMENT</span>
          <h1>Edit Data Meja</h1>
          <p>Perbarui informasi meja cafe.</p>
        </div>
        <a href="/meja" class="meja-btn meja-btn-back">
          Kembali
        </a>
      </div>

      <% if (pesan) { %>
        <div class="meja-alert" role="alert">
          <%= pesan %>
        </div>
      <% } %>

      <section class="meja-form-card">
        <h2>Form Edit Meja</h2>

        <form action="/meja/edit/<%= meja.id %>" method="POST">

          <div class="meja-form-group">
            <label for="nomor_meja">Nomor Meja</label>
            <input type="text"
                   id="nomor_meja"
                   name="nomor_meja"
                   value="<%= meja.nomor_meja %>"
                   maxlength="20"
                   required>
          </div>

          <div class="meja-form-group">
            <label for="kapasitas">Kapasitas Meja</label>
            <input type="number"
                   id="kapasitas"
                   name="kapasitas"
                   value="<%= meja.kapasitas %>"
                   min="1"
                   required>
          </div>

          <div class="meja-form-group">
            <label for="status">Status Meja</label>
            <select id="status" name="status" required>
              <option value="Tersedia"
                <%= String(meja.status).toLowerCase() === 'tersedia' ? 'selected' : '' %>>
                Tersedia
              </option>
              <option value="Terisi"
                <%= String(meja.status).toLowerCase() === 'terisi' ? 'selected' : '' %>>
                Terisi
              </option>
              <option value="Reservasi"
                <%= String(meja.status).toLowerCase() === 'reservasi' ? 'selected' : '' %>>
                Reservasi
              </option>
            </select>
          </div>

          <div class="meja-form-actions">
            <button type="submit" class="meja-btn meja-btn-primary">
              Simpan Perubahan
            </button>
            <a href="/meja" class="meja-btn meja-btn-back">
              Batal
            </a>
          </div>
        </form>
      </section>

    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
