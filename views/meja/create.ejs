
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tambah Meja</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main>
    <h1>Tambah Meja Baru</h1>

    <% if (pesan) { %>
      <p role="alert"><%= pesan %></p>
    <% } %>

    <form action="/meja/tambah" method="POST">

      <div>
        <label for="nomor_meja">Nomor Meja</label>
        <input
          type="text"
          id="nomor_meja"
          name="nomor_meja"
          placeholder="Contoh: M01"
          maxlength="20"
          required
        >
      </div>

      <div>
        <label for="kapasitas">Kapasitas</label>
        <input
          type="number"
          id="kapasitas"
          name="kapasitas"
          min="1"
          placeholder="Contoh: 4"
          required
        >
      </div>

      <div>
        <label for="status">Status Meja</label>
        <select id="status" name="status" required>
          <option value="Tersedia">Tersedia</option>
          <option value="Terisi">Terisi</option>
          <option value="Reservasi">Reservasi</option>
        </select>
      </div>

      <button type="submit">Simpan Meja</button>
      <a href="/meja">Kembali</a>
    </form>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
