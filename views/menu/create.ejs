<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tambah Menu</title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('../partials/head', { title: 'Tambah Menu' }) %>
</head>

<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <h1>Tambah Menu Cafe</h1>

    <% if (pesan) { %>
      <p role="alert"><%= pesan %></p>
    <% } %>

    <% if (kategori.length === 0) { %>
      <p>Belum ada kategori. Tambahkan kategori dahulu.</p>
    <% } %>

    <form action="/menu/tambah" method="POST">
      <p>
        <label for="nama">Nama Menu</label>
        <input type="text" id="nama"
               name="nama" maxlength="100" required>
      </p>

      <p>
        <label for="kategori_id">Kategori</label>
        <select id="kategori_id" name="kategori_id" required>
          <option value="">Pilih Kategori</option>

          <% kategori.forEach(item => { %>
            <option value="<%= item.id %>">
              <%= item.nama %>
            </option>
          <% }) %>
        </select>
      </p>

      <p>
        <label for="harga">Harga (Rp)</label>
        <input type="number" id="harga" name="harga"
               min="0" max="99999999.99"
               step="0.01" required>
      </p>

      <p>
        <label for="stok">Stok</label>
        <input type="number" id="stok" name="stok"
               min="0" step="1" required>
      </p>

      <p>
        <label for="gambar">Alamat Gambar (Opsional)</label>
        <input type="text" id="gambar" name="gambar"
               placeholder="/images/nama-menu.jpg">
      </p>

      <button type="submit"
        <%= kategori.length === 0 ? 'disabled' : '' %>>
        Simpan Menu
      </button>

      <a href="/menu">Kembali</a>
    </form>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
