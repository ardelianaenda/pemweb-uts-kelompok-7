<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../partials/head', { title: title }) %>
</head>

<body class="management-page">

    <%- include('../partials/navbar') %>

    <main class="container management-main">

        <section class="page-shell">
            <p class="section-label">Sunday Cafe Management</p>

            <h1 class="page-title">Kategori Menu</h1>

            <p class="page-subtitle">
                Kelola kategori makanan, minuman, dan dessert
                yang tersedia di Sunday Cafe.
            </p>
            
            <div class="category-list-actions">
                <a href="/kategori/tambah"
                class="btn-save">
                + Tambah Kategori
            </a>
        </div>
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="category-success" role="status">
                <%= successMessage %>
            </div>
            <% } %>

            <div class="table-card">
                <div class="table-responsive">

                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nama Kategori</th>
                                <th>Deskripsi</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (kategori.length === 0) { %>
                                <tr>
                                    <td colspan="3">
                                        Belum ada kategori menu.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% kategori.forEach(item => { %>
                                    <tr>
                                        <td><%= item.id %></td>
                                        <td><%= item.nama %></td>
                                        <td><%= item.deskripsi || '-' %></td>
                                        <td>
                                            <a
                                            href="/kategori/edit/<%= item.id %>"
                                            class="btn-edit"
                                            >
                                            ✎ Edit
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>

                </div>
            </div>
        </section>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>
